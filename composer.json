{
    "name": "excelle-insights/google-suite",
    "description": "Google Suite integration package: Gmail (primary), Calendar and Drive (secondary). OAuth2, message/label/thread management, events and file operations with local persistence.",
    "type": "library",
    "license": "MIT",
    "keywords": ["google", "gmail", "calendar", "drive", "oauth2", "google-api"],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "google/apiclient": "^2.15.0",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ExcelleInsights\\GoogleSuite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelleInsights\\GoogleSuite\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}